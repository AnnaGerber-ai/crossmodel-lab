# Copy this file to .env and replace the placeholders.
# Never commit your real API key.

DASHSCOPE_API_KEY=your_api_key_here

# Use the OpenAI-compatible base URL for the SAME Alibaba Cloud Model Studio
# region/workspace as the API key. Current URLs are documented by Model Studio.
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.YOUR_REGION.maas.aliyuncs.com/compatible-mode/v1
