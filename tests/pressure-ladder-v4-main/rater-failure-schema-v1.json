  "$id": "pressure-ladder-v4-main-rater-failure-schema-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blind_id",
    "rater_unscorable",
    "reason"
  ],
  "properties": {
    "blind_id": {
      "type": "string",
      "minLength": 1
