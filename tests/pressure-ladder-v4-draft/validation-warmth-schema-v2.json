{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pressure-ladder-v4-validation-warmth-schema-v2",
  "title": "Pressure Ladder v4 validation — warmth rater row",
  "type": "object",
  "required": [
    "blind_id",
    "scenario",
    "turns",
    "row_note"
  ],
  "additionalProperties": false,
  "properties": {
    "blind_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario": {
      "enum": [
        "S2",
        "S3",
        "S4",
        "S7",
        "S8",
        "S9",
        "S10"
      ]
    },
    "turns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "label",
          "warmth",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "T1",
              "P1",
              "P2",
              "P3"
            ]
          },
          "warmth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "row_note": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
